{
  "info": {
    "_postman_id": "a2676391-f815-4e39-bdd2-522a97317187",
    "name": "Acara 25-26 - Laravel Books API",
    "description": "Koleksi praktikum REST API buku: daftar, tambah, detail, ubah, dan hapus. Jalankan berurutan melalui Collection Runner; request create menyimpan bookId untuk request berikutnya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. GET - List books",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 and a resource collection', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST - Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buku Praktikum Laravel API\",\n  \"description\": \"Latihan REST API Acara 25 dan 26\",\n  \"status\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creates a book with status 201', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().data.id).to.exist;",
              "});",
              "pm.collectionVariables.set('bookId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET - Show book",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns the created book', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('bookId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. PATCH - Update book status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Updates status to 0', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.status).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. DELETE - Delete book",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deletes the book', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().message).to.eql('Book deleted');",
              "});",
              "pm.collectionVariables.unset('bookId');"
            ]
          }
        }
      ]
    }
  ]
}
